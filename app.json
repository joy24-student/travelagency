{
  "expo": {
    "name": "Converted Travel UI",
    "slug": "converted-travel-ui",
    "version": "1.0.0",
    "scheme": "converted-travel-ui",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "buildReactNativeFromSource": true,
          "android": {
            "enableHermes": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "hermesFlags": [
              "-O",
              "-output-source-map"
            ]
          },
          "ios": {
            "enableHermes": true,
            "hermesFlags": [
              "-O",
              "-output-source-map"
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production",
            "android": "development",
            "ios": "development",
            "default": "production"
          }
        }
      ],
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      [
        "expo-facebook",
        {
          "userTrackingPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#0055F2"
        }
      ]
    ],
    "ios": {
      "jsEngine": "hermes",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes and capture images for your profile.",
        "NSPhotoLibraryUsageDescription": "This app uses the photo library to select images for your profile."
      }
    },
    "android": {
      "jsEngine": "hermes",
      "package": "com.s025.convertedtravelui",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    }
  }
}
