{
  "expo": {
    "name": "Shopno Jatra",
    "slug": "shopnojatra",
    "version": "1.0.0",
    "scheme": [
      "shopnojatra",
      "converted-travel-ui"
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "buildReactNativeFromSource": true,
          "android": {
            "enableHermes": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "hermesFlags": [
              "-O",
              "-output-source-map"
            ]
          },
          "ios": {
            "enableHermes": true,
            "hermesFlags": [
              "-O",
              "-output-source-map"
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production",
            "android": "development",
            "ios": "development",
            "default": "production"
          }
        }
      ],
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#0055F2"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Your location is required to transmit emergency coordinates during SOS dispatch."
        }
      ]
    ],
    "ios": {
      "jsEngine": "hermes",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:shopnojatra.com",
        "applinks:*.shopnojatra.com"
      ],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes and capture images for your profile.",
        "NSPhotoLibraryUsageDescription": "This app uses the photo library to select images for your profile.",
        "NSLocationWhenInUseUsageDescription": "ShopnoJatra uses your location to show live weather, calculate distances to nearby tourist attractions, and assist with emergency SOS services.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Your location is required to transmit emergency coordinates during SOS dispatch.",
        "NSContactsUsageDescription": "This app needs access to your contacts so you can select trusted emergency contacts for SOS dispatch.",
        "NSMicrophoneUsageDescription": "This app requires microphone access for voice and video calls with travel agencies, tour guides, and customer support."
      },
      "bundleIdentifier": "com.shopnojatra.app"
    },
    "android": {
      "jsEngine": "hermes",
      "package": "com.shopnojatra.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.shopnojatra.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "shopnojatra.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "shopnojatra"
            },
            {
              "scheme": "converted-travel-ui"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    }
  }
}