# ============================================================================
# Shopno Jatra - Environment Variables Configuration
# Copy this file to .env and provide your production or local development keys.
# ============================================================================

# Supabase Client Configuration (Required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Firebase Client Configuration (Required)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Backend Python API
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Ed25519 Offline E-Ticket Cryptography
# Backend ONLY (Private Key - CRITICAL: Never embed in mobile apps or commit to public git):
TICKET_SIGNING_PRIVATE_KEY=your-32-byte-ed25519-private-key-hex
# Bundled in Mobile Clients (Public Key - Safe to expose for offline signature verification):
EXPO_PUBLIC_TICKET_PUBLIC_KEY=your-32-byte-ed25519-public-key-hex
